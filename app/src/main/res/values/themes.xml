<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Maragheh" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="android:statusBarColor">@color/brand_red_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Vazirmatn everywhere -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="textAppearanceDisplaySmall">@style/Text.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/Text.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/Text.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/Text.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/Text.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Text.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/Text.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/Text.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Text.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Text.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/Text.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/Text.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/Text.LabelSmall</item>

        <item name="materialCardViewStyle">@style/Widget.Maragheh.Card</item>
        <item name="toolbarStyle">@style/Widget.Maragheh.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.Maragheh.BottomNav</item>
        <item name="chipStyle">@style/Widget.Maragheh.Chip</item>
    </style>

    <style name="Theme.Maragheh" parent="Base.Theme.Maragheh" />

    <style name="Theme.Maragheh.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Maragheh</item>
    </style>

    <style name="Theme.Maragheh.Viewer" parent="Theme.Maragheh">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Typography -->
    <style name="Text.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/vazirmatn_bold</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
    </style>
    <style name="Text.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>
    <style name="Text.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="lineHeight">28sp</item>
    </style>
    <style name="Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="lineHeight">24sp</item>
    </style>
    <style name="Text.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
    </style>
    <style name="Text.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>
    <style name="Text.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>
    <style name="Text.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/vazirmatn_medium</item>
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.Maragheh.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.Maragheh.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/Text.TitleLarge</item>
    </style>

    <style name="Widget.Maragheh.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Maragheh.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/Text.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/Text.LabelMedium</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Maragheh.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>

    <style name="Widget.Maragheh.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/Text.LabelLarge</item>
    </style>

    <style name="Widget.Maragheh.RedToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand_red</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="titleTextAppearance">@style/Text.TitleLarge</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="WeatherPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">@style/Text.LabelMedium</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="MetaText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/Text.LabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ShapeRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius_small</item>
    </style>
    <style name="ShapeCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
